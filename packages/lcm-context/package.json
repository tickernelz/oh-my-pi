{
  "type": "module",
  "name": "@oh-my-pi/lcm-context",
  "version": "17.1.4",
  "description": "Rebuildable lossless-context projection and summary storage for Oh My Pi",
  "homepage": "https://github.com/tickernelz/oh-my-pi#readme",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tickernelz/oh-my-pi.git",
    "directory": "packages/lcm-context"
  },
  "bugs": {
    "url": "https://github.com/tickernelz/oh-my-pi/issues"
  },
  "keywords": [
    "context-management",
    "sqlite",
    "summarization",
    "llm"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "bun test --parallel",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write ."
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  }
}
